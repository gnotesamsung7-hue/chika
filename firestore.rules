rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: any signed-in user can look people up; only you can edit yours
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Chats (1:1 and groups): only members can see or change them
    match /chats/{chatId} {
      function isMember() {
        return request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.members.size() <= 50;

      match /messages/{msgId} {
        allow read: if isMember();
        allow create: if isMember()
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000;
      }

      // Photos and files, stored as chunks
      match /files/{fileId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == request.auth.uid
                      && request.resource.data.chunks <= 20;

        match /chunks/{chunkId} {
          allow read: if isMember();
          allow create: if isMember()
                        && request.resource.data.d is string
                        && request.resource.data.d.size() <= 750000;
        }
      }
    }
  }
}
